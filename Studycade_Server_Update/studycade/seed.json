      },
      {
        "id": 5,
        "term": "Reducing agent",
        "definition": "Loses electrons and is itself oxidized"
      },
      {
        "id": 6,
        "term": "Free element oxidation number",
        "definition": "Zero for an uncombined element such as Fe or O2"
      },
      {
        "id": 7,
        "term": "Monatomic ion oxidation number",
        "definition": "Equals the ion's charge"
      },
      {
        "id": 8,
        "term": "Oxygen oxidation number",
        "definition": "Usually −2 in compounds"
      },
      {
        "id": 9,
        "term": "Hydrogen oxidation number",
        "definition": "Usually +1 in compounds"
      },
      {
        "id": 10,
        "term": "Neutral compound oxidation sum",
        "definition": "The oxidation numbers add to zero"
      },
      {
        "id": 11,
        "term": "Polyatomic ion oxidation sum",
        "definition": "The oxidation numbers add to the ion's charge"
      },
      {
        "id": 12,
        "term": "Fe in Fe2O3",
        "definition": "+3 oxidation number"
      },
      {
        "id": 13,
        "term": "C in CO2",
        "definition": "+4 oxidation number"
      },
      {
        "id": 14,
        "term": "S in SO4²−",
        "definition": "+6 oxidation number"
      },
      {
        "id": 15,
        "term": "Single-replacement activity test",
