        "definition": "Metal name followed by the nonmetal root ending in -ide"
      },
      {
        "id": 4,
        "term": "Type II ionic name",
        "definition": "Metal name with a Roman numeral charge, then the anion name"
      },
      {
        "id": 5,
        "term": "Binary covalent name",
        "definition": "Use number prefixes for two nonmetals; omit mono- on the first element"
      },
      {
