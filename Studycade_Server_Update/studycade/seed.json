  {
    "id": "mole",
    "title": "The Mole & Conversions",
    "icon": "∞",
    "source": "Ch 3 pt 2 · HW Set 5",
    "cards": [
      {
        "id": 1,
        "term": "One mole",
        "definition": "6.022 × 10²³ particles"
      },
      {
        "id": 2,
        "term": "Avogadro's number",
        "definition": "6.022 × 10²³ particles per mole"
      },
      {
        "id": 3,
        "term": "Molar mass",
        "definition": "Mass in grams of one mole of a substance"
      },
      {
        "id": 4,
        "term": "Moles from grams",
        "definition": "Divide mass in grams by molar mass in g/mol"
      },
      {
        "id": 5,
        "term": "Grams from moles",
        "definition": "Multiply amount in moles by molar mass in g/mol"
      },
      {
        "id": 6,
        "term": "Particles from moles",
        "definition": "Multiply moles by 6.022 × 10²³ particles/mol"
      },
      {
        "id": 7,
        "term": "Moles from particles",
        "definition": "Divide particle count by 6.022 × 10²³ particles/mol"
      },
      {
        "id": 8,
        "term": "Formula-unit count",
        "definition": "Use this particle label for an ionic compound"
      },
      {
        "id": 9,
        "term": "Molecule count",
        "definition": "Use this particle label for a molecular compound"
      },
      {
        "id": 10,
        "term": "Molar mass of H2O",
        "definition": "About 18.02 g/mol"
      },
      {
        "id": 11,
        "term": "O atoms in Al2(CO3)3",
        "definition": "Nine oxygen atoms per formula unit"
      },
      {
        "id": 12,
        "term": "STP molar gas volume",
        "definition": "22.4 L per mole at the course's STP convention"
      }
    ]
  },
  {
    "id": "balancing",
    "title": "Writing & Balancing",
    "icon": "⚖",
    "source": "Ch 3 pt 3 · HW Set 7",
    "cards": [
      {
        "id": 1,
        "term": "Coefficient",
        "definition": "Number placed before a formula to balance an equation"
      },
      {
        "id": 2,
        "term": "Subscript",
        "definition": "Number within a formula showing atoms of an element"
      },
      {
        "id": 3,
        "term": "Conservation of atoms",
        "definition": "Each element has equal atom counts on both sides of a balanced equation"
      },
      {
        "id": 4,
        "term": "Balance Al + O2 → Al2O3",
        "definition": "4Al + 3O2 → 2Al2O3"
      },
      {
        "id": 5,
        "term": "Balance Zn + HCl → ZnCl2 + H2",
        "definition": "Zn + 2HCl → ZnCl2 + H2"
      },
      {
        "id": 6,
        "term": "Balance Fe(OH)3 → Fe2O3 + H2O",
        "definition": "2Fe(OH)3 → Fe2O3 + 3H2O"
      },
      {
        "id": 7,
        "term": "Balance C5H12 + O2 → CO2 + H2O",
        "definition": "C5H12 + 8O2 → 5CO2 + 6H2O"
      },
      {
        "id": 8,
        "term": "Balance NH4NO2 → N2 + H2O",
        "definition": "NH4NO2 → N2 + 2H2O"
      },
      {
        "id": 9,
        "term": "Balance P4 + O2 → P2O3",
        "definition": "P4 + 3O2 → 2P2O3"
      },
      {
        "id": 10,
        "term": "Balance BaCl2 + Na2CO3 → BaCO3 + NaCl",
        "definition": "BaCl2 + Na2CO3 → BaCO3 + 2NaCl"
      },
      {
        "id": 11,
        "term": "Balancing a polyatomic group",
        "definition": "Keep a polyatomic ion together when it remains unchanged on both sides"
      },
      {
        "id": 12,
        "term": "Combustion balancing order",
        "definition": "Balance carbon, then hydrogen, then oxygen"
      },
      {
        "id": 13,
        "term": "Smallest whole-number coefficients",
        "definition": "Standard form for coefficients in a balanced chemical equation"
      }
    ]
  },
  {
    "id": "stoich",
    "title": "Reaction Stoichiometry",
    "icon": "⇄",
    "source": "Ch 3 pt 4",
    "cards": [
      {
        "id": 1,
        "term": "Reaction mole ratio",
        "definition": "Ratio from the coefficients of a balanced equation"
      },
      {
        "id": 2,
        "term": "Composition mole ratio",
        "definition": "Ratio from subscripts within a single compound's formula"
      },
      {
        "id": 3,
        "term": "N2:H2:NH3 ratio",
        "definition": "1:3:2 in N2 + 3H2 → 2NH3"
      },
      {
        "id": 4,
        "term": "Moles of NH3 from 1 mol N2",
        "definition": "2 mol NH3, assuming sufficient H2"
      },
      {
        "id": 5,
        "term": "Mass-to-mass pathway",
        "definition": "Grams of A → moles of A → moles of B → grams of B"
      },
      {
        "id": 6,
        "term": "Limiting reactant",
        "definition": "Reactant that sets the maximum amount of product"
      },
      {
        "id": 7,
        "term": "Excess reactant",
        "definition": "Reactant remaining after the limiting reactant is used up"
      },
      {
        "id": 8,
        "term": "Theoretical yield",
        "definition": "Maximum calculated product amount from available reactants"
      },
      {
        "id": 9,
        "term": "Actual yield",
        "definition": "Amount of product measured experimentally"
      },
      {
        "id": 10,
        "term": "Percent yield",
        "definition": "Actual yield ÷ theoretical yield × 100%"
      },
      {
        "id": 11,
        "term": "Limiting-reactant comparison",
        "definition": "Compute possible product from each reactant; the smaller amount wins"
      },
      {
        "id": 12,
        "term": "Mole ratio for 2C6H14 → 14H2O",
        "definition": "1 mol C6H14 produces 7 mol H2O"
      },
      {
        "id": 13,
        "term": "Yield if actual 18.0 g and theoretical 24.6 g",
        "definition": "73.2%"
      }
    ]
  },
  {
